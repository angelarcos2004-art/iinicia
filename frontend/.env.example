# URL base del backend IINICIA (NestJS). Mientras no exista, lib/api.ts
# usa datos simulados automáticamente.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Client ID de OAuth 2.0 de Google (el mismo GOOGLE_CLIENT_ID del backend).
# No es secreto: se usa en el navegador para "Iniciar sesión con Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
