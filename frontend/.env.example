# URL base del backend IINICIA (NestJS). Mientras no exista, lib/api.ts
# usa datos simulados automáticamente.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL publica de Moodle (solo para enlazar "Ingresar al curso"; nunca el
# token, que vive unicamente en backend/.env segun CLAUDE.md).
NEXT_PUBLIC_MOODLE_URL=http://localhost:8080
