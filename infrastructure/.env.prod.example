# Copia a infrastructure/.env.prod en la VM (nunca lo subas al repo).
# Usado por docker-compose.prod.yml. No confundir con infrastructure/.env,
# que es solo para desarrollo local.

POSTGRES_USER=iinicia
POSTGRES_PASSWORD=cambia_esta_clave_por_una_larga_y_aleatoria
POSTGRES_DB=iinicia_backend

# IP publica de la VM con guiones en vez de puntos (ej. IP 34.12.45.9 ->
# 34-12-45-9). sslip.io resuelve cualquier subdominio con ese patron a esa
# IP, sin necesidad de comprar un dominio propio ni tocar DNS. Ver DEPLOY.md.
API_DOMAIN=api.34-12-45-9.sslip.io
CAMPUS_DOMAIN=campus.34-12-45-9.sslip.io
