# Copia este archivo a .env (NO lo subas al repositorio).

# Conexión a PostgreSQL
DATABASE_URL=postgresql://iinicia:cambia_esta_clave@localhost:5432/iinicia_backend

# Secreto para firmar JWT. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# (Opcional) Vigencia del token. Default: 1h
JWT_EXPIRES_IN=1h

# Puerto del backend. El portal espera 3001 (NEXT_PUBLIC_API_URL).
PORT=3001

# Origen del frontend permitido por CORS
ALLOWED_ORIGIN=http://localhost:3000

# (Opcional) Crear tablas automáticamente. Usar false en producción.
DB_SYNCHRONIZE=true

# --- Integración con Moodle (solo backend; nunca en frontend/ ni android/) ---
# URL base de Moodle, sin barra final. En desarrollo local: http://localhost:8080
MOODLE_URL=http://localhost:8080

# Token del servicio web externo de Moodle (ver infrastructure/README.md,
# sección "Habilitar Web Services"). Es un secreto: NO lo subas al repositorio.
# Déjalo vacío aquí y pon el valor real solo en tu backend/.env.
MOODLE_TOKEN=

# Id del rol "student" en Moodle (tabla mdl_role). Default: 5.
# Verifica el valor en tu instancia antes de cambiarlo.
MOODLE_ROLEID_STUDENT=5

# Id del rol "editingteacher" en Moodle (tabla mdl_role). Default: 3. Solo lo usa
# `npm run seed` para matricular a profesor.prueba como profesor en los cursos de
# infrastructure/moodle-seed-cursos.php. Verifica el valor en tu instancia antes de cambiarlo.
MOODLE_ROLEID_TEACHER=3

# Shortname del curso de prueba en el que se matricula al usuario tras
# vincularlo con Moodle. Default: IINICIA101.
MOODLE_TEST_COURSE=IINICIA101

# (Opcional, solo cuando el backend corre dentro de Docker) Host que Moodle
# espera recibir (su $CFG->wwwroot), necesario porque MOODLE_URL dentro de
# Docker usa el nombre del servicio ("http://moodle"), no ese host. Ya
# configurado en infrastructure/docker-compose.yml; no la pongas aquí si
# corres el backend local con npm run start:dev.
# MOODLE_HOST_HEADER=localhost:8080

# --- Notificaciones push (Firebase Cloud Messaging) ---
# JSON completo de la cuenta de servicio de tu proyecto Firebase (Project
# settings > Service accounts > Generate new private key), como una sola
# línea de texto. NUNCA lo subas al repositorio. Sin esto, las notificaciones
# push solo se registran en el log del backend, no se envían de verdad.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Recuperación de contraseña (envío de correo) ---
# Servidor SMTP. Sin MAIL_HOST, el enlace de recuperación solo se registra en
# el log del backend, no se envía ningún correo real.
# MAIL_HOST=smtp.tu-proveedor.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=no-responder@iinicia.org

# URL pública del portal, para armar el enlace de recuperación de contraseña.
FRONTEND_URL=http://localhost:3000

# Carpeta donde se guardan los documentos de admisión subidos por aspirantes
# (ver backend/src/documentos). Default: ./uploads (relativa al proceso del
# backend). Nunca se sube al repositorio.
# UPLOADS_DIR=./uploads

# --- Inicio de sesión con Google ---
# Client ID de OAuth 2.0 (tipo "Aplicación web") creado en Google Cloud
# Console > APIs & Services > Credentials. Debe coincidir con el
# NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend (el Client ID no es secreto).
GOOGLE_CLIENT_ID=
