# Copia este archivo a .env (NO lo subas al repositorio).

# Conexión a PostgreSQL
DATABASE_URL=postgresql://iinicia:cambia_esta_clave@localhost:5432/iinicia

# Secreto para firmar JWT. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# (Opcional) Vigencia del token. Default: 1h
JWT_EXPIRES_IN=1h

# Puerto del backend. El portal espera 3001 (NEXT_PUBLIC_API_URL).
PORT=3001

# Origen del frontend permitido por CORS
ALLOWED_ORIGIN=http://localhost:3000

# (Opcional) Crear tablas automáticamente. Usar false en producción.
DB_SYNCHRONIZE=true

# --- Integración con Moodle (solo backend; nunca en frontend/ ni android/) ---
# URL base de Moodle, sin barra final. En desarrollo local: http://localhost:8080
MOODLE_URL=http://localhost:8080

# Token del servicio web externo de Moodle (ver infrastructure/README.md,
# sección "Habilitar Web Services"). Es un secreto: NO lo subas al repositorio.
# Déjalo vacío aquí y pon el valor real solo en tu backend/.env.
MOODLE_TOKEN=

# Id del rol "student" en Moodle (tabla mdl_role). Default: 5.
# Verifica el valor en tu instancia antes de cambiarlo.
MOODLE_ROLEID_STUDENT=5

# Shortname del curso de prueba en el que se matricula al usuario tras
# vincularlo con Moodle. Default: IINICIA101.
MOODLE_TEST_COURSE=IINICIA101
